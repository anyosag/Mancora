* text=auto
*.swift text eol=lf
*.yml text eol=lf
*.sh text eol=lf
# Tables the app and the bridge read: the same bytes on every platform.
*.tsv text eol=lf
# Windows build inputs
*.ps1 text eol=crlf
*.iss text eol=crlf
*.rc text eol=crlf

# LUTs and test data must stay byte-identical on every platform. Some text
# LUTs use CRLF line ends, and phase.lut ends with a DOS end-of-file byte.
*.lut -text -diff
Resources/LUTs/*.txt -text
Tests/Fixtures/** -text
*.tif binary
*.tiff binary
*.icns binary
*.ico binary
*.png binary

# The Fiji sources kept for reference are not Mancora's code; keep their bytes as they are.
legacy/** -text linguist-vendored
Tests/MancoraPluginsTests/Fixtures/** -text
